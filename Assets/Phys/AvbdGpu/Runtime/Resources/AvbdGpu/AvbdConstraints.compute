// The active joint and spring lists (the joints and springs with an active body, gathered from the active bodies' link
// lists), the joint warm start (Joint::initialize) and the body -> constraint CSR lists used by the primal update and
// the colouring. Constraint index space (also used by the dual update and the wakes): [0, manifolds) manifolds, then
// the active joints, then the active springs.
#pragma kernel JointList
#pragma kernel JointListWoken
#pragma kernel PrepareJoints
#pragma kernel ConsClear
#pragma kernel ConsCount
#pragma kernel ConsFill
#pragma kernel ConsSort

#include "AvbdCommon.hlsl"

StructuredBuffer<BodyDef> _BodyDef;
StructuredBuffer<float4> _BodyPos;
StructuredBuffer<float4> _BodyRot;
StructuredBuffer<JointDef> _JointDef;
RWStructuredBuffer<JointState> _JointState;
StructuredBuffer<SpringDef> _SpringDef;
StructuredBuffer<Manifold> _ManifoldCur;
RWStructuredBuffer<uint> _Counters;
RWStructuredBuffer<uint> _BodyConsCount;
RWStructuredBuffer<uint> _BodyConsCursor;
StructuredBuffer<uint> _BodyConsStart;
RWStructuredBuffer<uint> _BodyConsList;
StructuredBuffer<uint> _BodySleep;         // sleep words: joints of sleeping bodies keep their state, their lists stay unsorted
StructuredBuffer<uint> _HotList;           // the bodies of the per-body passes
StructuredBuffer<uint> _WokenList;         // the bodies woken by a touch this step
StructuredBuffer<uint> _LinkStart;         // per-body (other body, constraint ref) lists: the joints and springs of a body
StructuredBuffer<uint2> _LinkList;
RWStructuredBuffer<uint> _ActiveJoints;    // the active joint list (indices into _JointDef)
RWStructuredBuffer<uint> _ActiveSprings;

bool active(int i) { return i >= 0 && activeBody(_BodyDef[i], _BodySleep[i]); }
bool woken(int i) { return i >= 0 && (_BodySleep[i] & SLEEP_WOKEN) != 0; }   // asleep at the start of the step, woken by a touch

// ------------------------------------------------------------------------------------------------ active lists

void appendJoint(uint j)
{
    uint slot;
    InterlockedAdd(_Counters[CNT_ACTIVE_JOINTS], 1, slot);
    if (slot < _JointCount) _ActiveJoints[slot] = j;
}

void appendSpring(uint sp)
{
    uint slot;
    InterlockedAdd(_Counters[CNT_ACTIVE_SPRINGS], 1, slot);
    if (slot < _SpringCount) _ActiveSprings[slot] = sp;
}

// Every active hot body walks its links: a joint or spring joins the active list once, from body B when B is active,
// otherwise from body A (world-anchored joints have only B). Broken joints are left out.
[numthreads(AVBD_THREADS, 1, 1)]
void JointList(uint3 id : SV_DispatchThreadID)
{
    HOT_BODY(id, b)
    if (!active((int)b)) return;
    uint start = _LinkStart[b], end = _LinkStart[b + 1];
    for (uint k = start; k < end; k++)
    {
        uint r = _LinkList[k].y;
        uint type = CONS_TYPE(r);
        uint idx = CONS_INDEX(r);
        if (type == CONS_JOINT)
        {
            if (_JointState[idx].broken) continue;
            JointDef d = _JointDef[idx];
            if (d.bodyB == (int)b || !active(d.bodyB)) appendJoint(idx);
        }
        else if (type == CONS_SPRING)
        {
            SpringDef sd = _SpringDef[idx];
            if (sd.bodyB == (int)b || !active(sd.bodyB)) appendSpring(idx);
        }
    }
}

// After the touches woke bodies: their joints and springs join the lists unless a body that was active at the start
// of the step already brought them (again once each: from B, or from A when B is not woken either).
[numthreads(AVBD_THREADS, 1, 1)]
void JointListWoken(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Counters[CNT_WOKEN_LIST]) return;
    uint w = _WokenList[id.x];
    uint start = _LinkStart[w], end = _LinkStart[w + 1];
    for (uint k = start; k < end; k++)
    {
        uint r = _LinkList[k].y;
        uint type = CONS_TYPE(r);
        uint idx = CONS_INDEX(r);
        int a, b;
        if (type == CONS_JOINT)
        {
            if (_JointState[idx].broken) continue;
            JointDef d = _JointDef[idx];
            a = d.bodyA; b = d.bodyB;
        }
        else if (type == CONS_SPRING)
        {
            SpringDef sd = _SpringDef[idx];
            a = sd.bodyA; b = sd.bodyB;
        }
        else continue;
        bool activeBefore = (active(a) && !woken(a)) || (active(b) && !woken(b));
        if (activeBefore) continue;
        bool mine = b == (int)w || !woken(b);
        if (!mine) continue;
        if (type == CONS_JOINT) appendJoint(idx); else appendSpring(idx);
    }
}

// ------------------------------------------------------------------------------------------------ joints

[numthreads(AVBD_THREADS, 1, 1)]
void PrepareJoints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Counters[CNT_ACTIVE_JOINTS]) return;
    uint j = _ActiveJoints[id.x];
    JointDef d = _JointDef[j];
    JointState s = _JointState[j];
    if (s.broken) return;

    float3 pA = d.rA;
    float4 qA = float4(0, 0, 0, 1);
    if (d.bodyA >= 0)
    {
        qA = _BodyRot[d.bodyA];
        pA = qtransform(_BodyPos[d.bodyA].xyz, qA, d.rA);
    }
    float4 qB = _BodyRot[d.bodyB];
    float3 pB = qtransform(_BodyPos[d.bodyB].xyz, qB, d.rB);

    // Store constraint function at beginning of timestep C(x-)
    s.C0Lin = pA - pB;
    s.C0Ang = qsub(qA, qB) * d.torqueArm;

    // Warmstart the dual variables and penalty parameters (Eq. 19)
    s.lambdaLin *= _LambdaDecay;
    s.lambdaAng *= _LambdaDecay;
    s.penaltyLin = clamp(s.penaltyLin * _Gamma, PENALTY_MIN, PENALTY_MAX);
    s.penaltyAng = clamp(s.penaltyAng * _Gamma, PENALTY_MIN, PENALTY_MAX);

    // Clamp penalty to material stiffness
    s.penaltyLin = min(s.penaltyLin, d.stiffnessLin);
    s.penaltyAng = min(s.penaltyAng, d.stiffnessAng);
    _JointState[j] = s;
}

// Decodes a constraint index into (type, index, bodyA, bodyB); returns false for inactive constraints.
bool decodeConstraint(uint t, out uint type, out uint idx, out int a, out int b)
{
    uint m = _Counters[CNT_MANIFOLDS];
    type = 0; idx = 0; a = -1; b = -1;
    if (t < m)
    {
        Manifold mf = _ManifoldCur[t];
        type = CONS_MANIFOLD; idx = t; a = (int)mf.bodyA; b = (int)mf.bodyB;
        return true;
    }
    t -= m;
    uint joints = _Counters[CNT_ACTIVE_JOINTS];
    if (t < joints)
    {
        uint j = _ActiveJoints[t];
        if (_JointState[j].broken) return false;
        JointDef d = _JointDef[j];
        type = CONS_JOINT; idx = j; a = d.bodyA; b = d.bodyB;
        return true;
    }
    t -= joints;
    if (t < _Counters[CNT_ACTIVE_SPRINGS])
    {
        uint sp = _ActiveSprings[t];
        SpringDef d = _SpringDef[sp];
        type = CONS_SPRING; idx = sp; a = d.bodyA; b = d.bodyB;
        return true;
    }
    return false;
}

bool dynamicBody(int i) { return i >= 0 && !isStatic(_BodyDef[i]); }

[numthreads(AVBD_THREADS, 1, 1)]
void ConsClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _BodyCount) return;
    _BodyConsCount[id.x] = 0;
    _BodyConsCursor[id.x] = 0;
}

[numthreads(AVBD_THREADS, 1, 1)]
void ConsCount(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Counters[CNT_CONSTRAINTS]) return;
    uint type, idx; int a, b;
    if (!decodeConstraint(id.x, type, idx, a, b)) return;
    uint dummy;
    if (dynamicBody(a)) InterlockedAdd(_BodyConsCount[a], 1, dummy);
    if (dynamicBody(b)) InterlockedAdd(_BodyConsCount[b], 1, dummy);
}

[numthreads(AVBD_THREADS, 1, 1)]
void ConsFill(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Counters[CNT_CONSTRAINTS]) return;
    uint type, idx; int a, b;
    if (!decodeConstraint(id.x, type, idx, a, b)) return;
    uint r = CONS_REF(type, idx);
    uint slot;
    if (dynamicBody(a))
    {
        InterlockedAdd(_BodyConsCursor[a], 1, slot);
        _BodyConsList[_BodyConsStart[a] + slot] = r;
    }
    if (dynamicBody(b))
    {
        InterlockedAdd(_BodyConsCursor[b], 1, slot);
        _BodyConsList[_BodyConsStart[b] + slot] = r;
    }
}

// Sort key: manifolds by the neighbour index (unique per body), joints and springs by their CPU-assigned index.
uint consKey(uint r, uint body)
{
    uint type = CONS_TYPE(r);
    uint idx = CONS_INDEX(r);
    if (type == CONS_MANIFOLD)
    {
        Manifold m = _ManifoldCur[idx];
        return m.bodyA == body ? m.bodyB : m.bodyA;
    }
    return CONS_REF(type, idx);
}

// Insertion sort of each dynamic body's list so that the accumulation order in the primal update is deterministic.
[numthreads(AVBD_THREADS, 1, 1)]
void ConsSort(uint3 id : SV_DispatchThreadID)
{
    HOT_BODY(id, body)
    if (!active((int)body)) return;   // sleeping bodies are not solved; their lists serve the islands and wakes unsorted
    uint start = _BodyConsStart[body];
    uint end = _BodyConsStart[body + 1];
    for (uint i = start + 1; i < end; i++)
    {
        uint r = _BodyConsList[i];
        uint key = consKey(r, body);
        uint j = i;
        while (j > start)
        {
            uint prev = _BodyConsList[j - 1];
            if (consKey(prev, body) <= key) break;
            _BodyConsList[j] = prev;
            j--;
        }
        _BodyConsList[j] = r;
    }
}
