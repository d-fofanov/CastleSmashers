// The renderer's kernels: debug geometry written on the GPU (contact crosses per manifold, from the previous step's manifold
// list; joint and spring lines), drawn with Phys/AvbdLines and never read back, and the bounds of the body ranges the
// renderer draws, read back asynchronously for Unity's culling.
#pragma kernel DebugArgs
#pragma kernel DebugContacts
#pragma kernel DebugJoints
#pragma kernel RangeBounds

#include "AvbdCommon.hlsl"

struct DebugVertex { float4 position; float4 color; };

StructuredBuffer<float4> _BodyPos;
StructuredBuffer<float4> _BodyRot;
StructuredBuffer<uint> _Stats;
StructuredBuffer<Manifold> _ManifoldPrev;
StructuredBuffer<Contact> _ContactsPrev;
StructuredBuffer<JointDef> _JointDef;
StructuredBuffer<JointState> _JointState;
StructuredBuffer<SpringDef> _SpringDef;
RWStructuredBuffer<DebugVertex> _DebugVerts;
RWStructuredBuffer<DebugVertex> _DebugJointVerts;
RWByteAddressBuffer _DrawArgs;
uint _DebugContactCap;
float _CrossSize;
StructuredBuffer<BodyDef> _BodyDef;
StructuredBuffer<uint2> _Ranges;              // start, count of every range drawn
RWStructuredBuffer<float4> _RangeBounds;      // per range: min, max (xyz) of position +- bounding radius; min > max when empty
groupshared float3 gs_Min[AVBD_THREADS];
groupshared float3 gs_Max[AVBD_THREADS];

[numthreads(1, 1, 1)]
void DebugArgs(uint3 id : SV_DispatchThreadID)
{
    uint contacts = min(_Stats[CNT_CONTACTS], _DebugContactCap);
    _DrawArgs.Store4(0, uint4(contacts * 6, 1, 0, 0));
}

void writeCross(RWStructuredBuffer<DebugVertex> verts, uint baseIndex, float3 p, float4 color, float s)
{
    DebugVertex v; v.color = color;
    v.position = float4(p - float3(s, 0, 0), 1); verts[baseIndex + 0] = v;
    v.position = float4(p + float3(s, 0, 0), 1); verts[baseIndex + 1] = v;
    v.position = float4(p - float3(0, s, 0), 1); verts[baseIndex + 2] = v;
    v.position = float4(p + float3(0, s, 0), 1); verts[baseIndex + 3] = v;
    v.position = float4(p - float3(0, 0, s), 1); verts[baseIndex + 4] = v;
    v.position = float4(p + float3(0, 0, s), 1); verts[baseIndex + 5] = v;
}

[numthreads(AVBD_THREADS, 1, 1)]
void DebugContacts(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Stats[CNT_MANIFOLDS]) return;
    Manifold m = _ManifoldPrev[id.x];
    float3 posA = _BodyPos[m.bodyA].xyz;
    float4 rotA = _BodyRot[m.bodyA];
    for (uint i = 0; i < m.numContacts; i++)
    {
        uint ci = m.contactStart + i;
        if (ci >= _DebugContactCap) continue;
        Contact c = _ContactsPrev[ci];
        float3 p = qtransform(posA, rotA, c.rA);
        bool stick = (c.feature & 0x80000000u) != 0;
        float4 color = stick ? float4(0.2, 0.9, 0.2, 1) : float4(0.9, 0.15, 0.15, 1);
        writeCross(_DebugVerts, ci * 6, p, color, _CrossSize);
    }
}

// Joints then springs: 2 vertices each
[numthreads(AVBD_THREADS, 1, 1)]
void DebugJoints(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    DebugVertex v;
    if (i < _JointCount)
    {
        JointDef d = _JointDef[i];
        JointState s = _JointState[i];
        float3 pA = d.rA;
        if (d.bodyA >= 0) pA = qtransform(_BodyPos[d.bodyA].xyz, _BodyRot[d.bodyA], d.rA);
        float3 pB = qtransform(_BodyPos[d.bodyB].xyz, _BodyRot[d.bodyB], d.rB);
        bool active = s.broken == 0 && (d.stiffnessLin > 0 || d.stiffnessAng > 0);
        v.color = !active ? float4(0.3, 0.3, 0.3, 1) : d.stiffnessLin >= HARD_STIFFNESS ? float4(0.9, 0.1, 0.1, 1) : float4(1.0, 0.6, 0.1, 1);
        if (!active) { pA = 0; pB = 0; }
        v.position = float4(pA, 1); _DebugJointVerts[i * 2] = v;
        v.position = float4(pB, 1); _DebugJointVerts[i * 2 + 1] = v;
        return;
    }
    i -= _JointCount;
    if (i < _SpringCount)
    {
        SpringDef d = _SpringDef[i];
        float3 pA = qtransform(_BodyPos[d.bodyA].xyz, _BodyRot[d.bodyA], d.rA);
        float3 pB = qtransform(_BodyPos[d.bodyB].xyz, _BodyRot[d.bodyB], d.rB);
        v.color = float4(0.95, 0.85, 0.2, 1);
        uint o = (_JointCount + i) * 2;
        v.position = float4(pA, 1); _DebugJointVerts[o] = v;
        v.position = float4(pB, 1); _DebugJointVerts[o + 1] = v;
    }
}

// One thread group per range: the world AABB of its bodies (position +- the bounding radius of the box, dead slots and the
// terrain slot skipped), reduced through group shared memory. The renderer reads the result back a few frames later and
// draws the range with it, inflated by a margin, so that Unity culls what is out of the camera's frustum and of the shadow
// cascades' volumes.
[numthreads(AVBD_THREADS, 1, 1)]
void RangeBounds(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
    uint2 range = _Ranges[gid.x];
    float3 lo = 1e30, hi = -1e30;
    for (uint i = tid.x; i < range.y; i += AVBD_THREADS)
    {
        uint b = range.x + i;
        BodyDef d = _BodyDef[b];
        if (d.flags & (FLAG_DEAD | FLAG_TERRAIN)) continue;
        float3 p = _BodyPos[b].xyz;
        lo = min(lo, p - d.radius);
        hi = max(hi, p + d.radius);
    }
    gs_Min[tid.x] = lo;
    gs_Max[tid.x] = hi;
    GroupMemoryBarrierWithGroupSync();
    for (uint s = AVBD_THREADS / 2; s > 0; s >>= 1)
    {
        if (tid.x < s)
        {
            gs_Min[tid.x] = min(gs_Min[tid.x], gs_Min[tid.x + s]);
            gs_Max[tid.x] = max(gs_Max[tid.x], gs_Max[tid.x + s]);
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (tid.x == 0)
    {
        _RangeBounds[gid.x * 2] = float4(gs_Min[0], 0);
        _RangeBounds[gid.x * 2 + 1] = float4(gs_Max[0], 0);
    }
}
